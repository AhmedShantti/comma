# App Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# Database Configuration (⚠️ CHANGE IN PRODUCTION)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=pos_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration (⚠️ GENERATE SECURE RANDOM STRINGS FOR PRODUCTION - min 32 chars)
JWT_ACCESS_SECRET=your-secure-random-access-secret-minimum-32-characters-long
JWT_ACCESS_EXPIRATION=30m
JWT_REFRESH_SECRET=your-secure-random-refresh-secret-minimum-32-characters-long
JWT_REFRESH_EXPIRATION=7d

# CORS Configuration (⚠️ UPDATE FOR PRODUCTION - Add only trusted origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4200

# Rate Limiting/Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Restaurant
RESTAURANT_NAME=My Restaurant
RESTAURANT_NAME_AR=مطعمي
ADDRESS=123 Main St
PHONE=+966123456789
VAT_RATE=15
TIMEZONE=Asia/Riyadh
