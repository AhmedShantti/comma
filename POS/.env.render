# ===== RENDER DEPLOYMENT ENVIRONMENT =====
# Copy this to .env and update with actual values from Render

NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# Database - will be provided by Render (from connected Postgres service)
# For manual setup, use: postgresql://user:password@host:port/database
DATABASE_URL=

# Redis - optional, Render doesn't provide free Redis
# Comment out if not using Redis cache
REDIS_HOST=
REDIS_PORT=6379

# JWT Secrets - CHANGE THESE! Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRATION=30m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=7d

# CORS - update with your Vercel frontend URL
CORS_ORIGINS=https://your-vercel-app.vercel.app
FRONTEND_URL=https://your-vercel-app.vercel.app

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Restaurant Info
RESTAURANT_NAME=COMMA Café & Lounge
RESTAURANT_NAME_AR=كوما كافيه ولاونج
ADDRESS=Cairo, Egypt
PHONE=+20123456789
VAT_RATE=15
TIMEZONE=Africa/Cairo
